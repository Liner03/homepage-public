# 服务器配置
PORT=3000
NODE_ENV=development

# GitHub Token (用于精确贡献日历，可选)
# 获取地址：https://github.com/settings/tokens
# 创建 Fine-grained token，选择"只读公共仓库"权限
GITHUB_TOKEN=your_github_token_here

# 访问统计存储方式：json | sqlite | cloudflare
VISIT_STORAGE=json

# Cloudflare KV 配置 (仅当 VISIT_STORAGE=cloudflare 时需要)
# CLOUDFLARE_ACCOUNT_ID=your_account_id
# CLOUDFLARE_NAMESPACE_ID=your_namespace_id
# CLOUDFLARE_API_TOKEN=your_api_token

# 数据存储路径
DATA_DIR=./data

# 管理后台账号配置
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password_123
SESSION_SECRET=change_this_secret_key_random_string
